{
  "name": "dsh-mem0-dock-tuner",
  "version": "0.1.0",
  "description": "Tiny toggle for the dsh-mem0 composer dock badge: hide or show the memory activity indicator without touching the mem0 plugin.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mem0",
    "ui"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
